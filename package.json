{
  "name": "albert",
  "version": "1.0.1",
  "private": true,
  "description": "Training tool for colorimetry",
  "scripts": {
    "test": "vitest run",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "serve": "serve out",
    "build-static": "cross-env ALBERT_STATIC=true next build",
    "serve-static": "npm run build-static && npm run serve",
    "build-prod": "cross-env ALBERT_ENV=production next build"
  },
  "dependencies": {
    "munsell": "^1.1.7",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
